# ShipFlow environment template. PLACEHOLDER VALUES ONLY.
# Copy to `.env` (git-ignored) and replace every CHANGE_ME value locally.
# Never commit real passwords, signing keys or connection strings.
#
# ASP.NET Core maps double-underscore names to nested configuration keys.

ASPNETCORE_ENVIRONMENT=Development

# --- Phase 2 (Persistence and Identity) ---
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=ShipFlow;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True
Jwt__Issuer=ShipFlow
Jwt__Audience=ShipFlow.Clients
Jwt__SigningKey=CHANGE_ME_USE_A_RANDOM_KEY_OF_AT_LEAST_32_BYTES
Jwt__AccessTokenMinutes=15
# Development only: password for demo users
# Seed__DevPassword=CHANGE_ME_Aa1_example
# Integration tests against SQL Server (server login that may create/drop databases)
# SHIPFLOW_TEST_SQLSERVER=Server=localhost,1433;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True

# --- Introduced in Phase 9 (Docker) ---
# MSSQL_SA_PASSWORD=CHANGE_ME

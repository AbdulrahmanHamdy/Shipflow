# ShipFlow Frontend Environment Configuration Example
# Copy to .env or .env.local for local overrides. Do NOT commit real secrets.

# API Base URL (empty string uses current origin / Vite dev proxy)
VITE_API_BASE_URL=

# Backend target for Vite dev proxy when running locally
VITE_BACKEND_URL=http://localhost:5000

# Leaflet tile provider (defaults to OpenStreetMap tiles)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ShipFlow",
    "Audience": "ShipFlow.Clients",
    "AccessTokenMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedReferenceData": true,
    "SeedDevelopmentData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}

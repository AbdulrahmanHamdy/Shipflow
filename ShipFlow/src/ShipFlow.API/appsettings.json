{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ShipFlow;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ShipFlow",
    "Audience": "ShipFlow.Clients",
    "AccessTokenMinutes": 15
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedReferenceData": true,
    "SeedDevelopmentData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "TrackingPermitLimit": 60,
    "TrackingWindowSeconds": 60
  },
  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SenderName": "ShipFlow",
    "SenderEmail": "",
    "SenderPassword": "",
    "EnableSsl": true
  },
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com",
    "ApiKey": "",
    "PublicKey": "",
    "HmacSecret": "",
    "IntegrationId": "",
    "IframeId": ""
  }
}
